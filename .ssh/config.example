# Copy to ./.ssh/config and point IdentityFile at whichever deploy key you
# drop into ./.ssh (see ../README.md "Private repos over SSH"). Not required
# if you only ever have ONE key in ./.ssh named id_rsa — ssh picks that up
# automatically. A config is needed when using a differently-named key, or
# when your own ~/.ssh already has a github.com entry you don't want this
# build to inherit.

#ideabosque account
Host github.com
	HostName github.com
	IdentityFile ~/.ssh/ideabosque_id_rsa
	IdentitiesOnly yes

.env
.env.local
# Deploy keys — never commit. Only .gitkeep and the sanitized config.example
# template are tracked.
.ssh/*
!.ssh/.gitkeep
!.ssh/config.example
# Personal/local-only addon modules (e.g. a work-in-progress addon that
# depends on a package not yet in requirements.txt, or a one-off local
# experiment). Shared addon config stays a plain addons/<name>.yaml (tracked)
# — see addons/README.md.
addons/*.local.yaml
addons/*.local.yml
logs/*
data/*
www/*
postgres_data/*
postgres_logs/*
backups/*
!backups/.gitkeep
!www/.gitkeep
!www/logs/.gitkeep
!www/projects/.gitkeep
!www/hermes/.gitkeep
!www/openclaw/.gitkeep
!www/pi-workspace/.gitkeep
*.bak
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Generated test reports and execution evidence. The report *shape*
# documentation of the long-running task suite is tracked; the generated
# reports stay ignored (they are local execution evidence).
/docs/test_results/*
!/docs/test_results/long_running_tasks/
/docs/test_results/long_running_tasks/*
!/docs/test_results/long_running_tasks/README.md

# Operator-owned composition of project deployments.
/compose.projects.local.yaml

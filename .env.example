# =============================================================================
# docker-a2a-gateway — container environment (TEMPLATE)
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; this template is committed. NEVER put real secrets here.
#
# IMPORTANT: docker compose's env_file parser does NOT strip inline comments.
# A line like   KEY=value   # comment   sets KEY to "value   # comment".
# Keep every value on its own line with NOTHING after the value. Put notes on
# the comment lines above each variable.
#
# The image is generic and entirely env-driven: no secrets are baked in.
# docker-compose reads CONTAINER_PORT / GATEWAY_PORT for host port mapping and
# feeds the rest to the gateway, which forwards module settings (Hermes,
# OpenClaw, AWS, auth) to a2a_daemon_engine's Config.initialize().
#
# This stack bundles TWO optional agent bridges — Hermes and OpenClaw — as
# independent compose profiles. Enable one, the other, both, or neither (and
# point *_API_URL at an external instance instead). Per-agent DB records can
# address either bridge by agent_uuid regardless of which one is the
# env-var fallback default (A2A_AI_AGENT_MODULE / A2A_AI_AGENT_CLASS below).
# =============================================================================

# ── Port mapping ───────────────────────────────────────────────────────────
# CONTAINER_PORT is the host port; GATEWAY_PORT is the in-container bind port.
CONTAINER_PORT=8765
GATEWAY_PORT=8765
GATEWAY_HOST=0.0.0.0
# GATEWAY_WORKERS > 1 requires shared task/rate/SSE backends (see below).
GATEWAY_WORKERS=1
A2A_GATEWAY_CONTAINER_NAME=a2a-gateway

# ── Route manifest ─────────────────────────────────────────────────────────
# The image bakes an A2A-only manifest at /app/routes.yaml and the Dockerfile
# sets GATEWAY_ROUTES_CONFIG_PATH=/app/routes.yaml, so no env var is needed for
# the default. docker-compose mounts ./routes.yaml over that path; edit it on
# the host + restart the container — no rebuild. To mount a different host
# file instead, set GATEWAY_ROUTES_HOST_FILE (compose volume source).
GATEWAY_ROUTES_HOST_FILE=./routes.yaml

# ── Addon modules (drop-in) ──────────────────────────────────────────────────
# routes.yaml has one permanent `!include data/_addons_generated.yaml` line.
# At container startup, the entrypoint merges every *.yaml/*.yml file under
# ADDONS_HOST_DIR into that generated file — so registering (or removing) an
# addon module never requires editing routes.yaml itself. See
# ./addons/README.md. Empty folder = no modules registered at all —
# a2a_daemon_engine itself is a drop-in file (addons/a2a_daemon_engine.yaml).
ADDONS_HOST_DIR=./addons

# ── CORS ───────────────────────────────────────────────────────────────────
# "*" (or unset) = allow any origin WITHOUT credentials. Set a comma-separated
# list (e.g. https://app.example.com) to also allow credentials/cookies. A
# wildcard and credentials are mutually exclusive per spec.
GATEWAY_CORS_ORIGINS=*

# ── Performance tuning ──────────────────────────────────────────────────────
# Sync dispatch thread pool size.
GATEWAY_DISPATCH_WORKERS=32

# ── Auth (gateway) ──────────────────────────────────────────────────────────
# local | cognito
GATEWAY_AUTH_PROVIDER=local
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# token lifetime (minutes)
ACCESS_TOKEN_EXP=15
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional pre-minted permanent admin token (uncomment to use):
# ADMIN_STATIC_TOKEN=

# Local user file (optional). Drop users.json into ./data and uncomment:
# LOCAL_USER_FILE=/app/data/users.json

# ── AWS Cognito (only when GATEWAY_AUTH_PROVIDER=cognito) ───────────────────
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_SECRET=
# COGNITO_JWKS_URL=

# ── Shared-store backends (required when GATEWAY_WORKERS > 1) ───────────────
# memory | dynamodb
GATEWAY_TASK_BACKEND=memory
GATEWAY_TASK_TTL=3600
# memory | dynamodb
GATEWAY_RATE_LIMIT_BACKEND=memory
GATEWAY_RATE_LIMIT=500
GATEWAY_RATE_WINDOW=60

# =============================================================================
# PostgreSQL (sole persistence backend — optional bundled service)
# =============================================================================
# a2a_daemon_engine persists to PostgreSQL (db_backend=postgresql is forced
# in the image — no DynamoDB option). Two ways to provide Postgres:
#
#   A. Bundled: include `postgres` in COMPOSE_PROFILES (adds the postgres
#               service) and keep PG_HOST=postgres. POSTGRES_* must match
#               PG_USER/PASSWORD/DB.
#   B. External: leave the profile OFF and point PG_* at your own Postgres
#                (e.g. PG_HOST=host.docker.internal or a remote host).
#
# a2a_daemon_engine uses LITERAL (unprefixed) table names: a2a_agents,
# a2a_tasks, a2a_messages, a2a_settings. Do not share PG_DB with another
# module using those names. Tables + RLS tenant-isolation policies are
# auto-created on gateway startup when initialize_tables=1.
PG_HOST=postgres
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=silvaengine
PG_DB=silvaengine
initialize_tables=1
# overrides PG_* (alembic migrations) if set:
# DATABASE_URL=

# ── Bundled PostgreSQL service (profile: postgres) ──────────────────────────
# Enable via the COMPOSE_PROFILES line below (adding `postgres` to it). Keep
# PG_HOST=postgres when bundled. These POSTGRES_* values must match
# PG_USER/PG_PASSWORD/PG_DB above.
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=a2a-postgres
POSTGRES_USER=silvaengine
POSTGRES_PASSWORD=silvaengine
POSTGRES_DB=silvaengine
POSTGRES_PORT=5432
# host dir for the PG data directory:
POSTGRES_DATA_PATH=./postgres_data
# host dir for PG log files:
POSTGRES_LOG_PATH=./postgres_logs
# none | ddl | mod | all:
LOG_STATEMENT=none
# log queries slower than N ms (-1 disables):
LOG_MIN_DURATION=1000

# =============================================================================
# A2A bridge — fallback handler selection (a2a_daemon_engine)
# =============================================================================
# Config resolution priority (per-agent):
#   1. Agent metadata (DB)  — highest, per-agent routing
#   2. Setting dict          — fallback
#   3. Config class (env vars below) — lowest, global default
#
# These three env vars pick the DEFAULT handler used when a request targets
# no agent record with its own module/class metadata. Point them at the
# Hermes bridge (default here) OR the OpenClaw bridge — whichever bundled
# agent you want requests to reach when no per-agent DB record says
# otherwise. Both handler classes are always importable regardless of this
# default: register a second agent record in a2a_agents (via
# /{ep}/a2a_core_graphql) with its own module/class/agent_uuid to reach the
# OTHER bridge explicitly by agent_uuid, so both Hermes and OpenClaw can be
# addressed side by side.
#
#   Hermes:   a2a_daemon_engine.handlers.a2a_hermes_handler / HermesAgentHandler
#   OpenClaw: a2a_daemon_engine.handlers.a2a_openclaw_handler / OpenClawAgentHandler
A2A_AI_AGENT_MODULE=a2a_daemon_engine.handlers.a2a_hermes_handler
A2A_AI_AGENT_CLASS=HermesAgentHandler
A2A_DEFAULT_AGENT_UUID=a2a-hermes-agent
A2A_STREAM_TIMEOUT=120.0
A2A_STREAMING_ENABLED=true

# =============================================================================
# Option A — Hermes Agent A2A Bridge
# =============================================================================
# Forwarded to a2a_daemon_engine.handlers.config:Config so the bridge can route
# A2A tasks to a Hermes Agent API Server instance via HTTP + SSE instead of
# in-process LLM calls.
#
# Prerequisites:
#   - Hermes API Server running (API_SERVER_ENABLED=true, API_SERVER_KEY set)
#   - a2a_daemon_engine installed (it is — baked into this image)
#
# When the `hermes` compose profile is active, the bundled sibling Hermes
# service is reachable at http://hermes:<API_SERVER_PORT>. When the profile is
# off, point HERMES_API_URL at an external Hermes API Server.
HERMES_API_URL=http://hermes:8642
# Bearer token for the Hermes API Server — MUST match API_SERVER_KEY below.
HERMES_API_KEY=
# NOTE: this single var plays TWO roles — the A2A bridge sends it to Hermes
# as the model id, AND (further down) the bundled Hermes service reads the
# same HERMES_MODEL as its own default profile model. There is only one
# value; when running the bundled Hermes, set it to the provider model id
# Hermes itself should use (e.g. claude-opus-4-8).
HERMES_MODEL=hermes-agent
# SSE stream timeout in seconds:
HERMES_STREAM_TIMEOUT=300

# ── Bundled Hermes Agent (compose profile: hermes) ──────────────────────────
# The Hermes Agent runs as a sibling container ONLY when `hermes` is in
# COMPOSE_PROFILES. Empty/omitted = external Hermes only (use HERMES_API_URL
# above to point at it). When the profile is on, keep HERMES_API_URL pointing
# at http://hermes:<API_SERVER_PORT> so the gateway reaches it.
HERMES_IMAGE=nousresearch/hermes-agent
HERMES_TAG=latest
HERMES_COMMAND=gateway run
HERMES_CONTAINER_NAME=container-hermes

# ── Hermes persistent data ──────────────────────────────────────────────────
# Single source of truth for ALL Hermes state. Defaults to ./www/hermes.
HERMES_DATA_FOLDER=./www/hermes
DOCKER_SOCK=/var/run/docker.sock
HERMES_UID=1000
HERMES_GID=1000
HERMES_SHM_SIZE=1g
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0

# ── Hermes ports ────────────────────────────────────────────────────────────
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119

# ── Hermes dashboard ────────────────────────────────────────────────────────
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Hermes OpenAI-compatible API server ─────────────────────────────────────
# Generate with: openssl rand -hex 32. Also set as HERMES_API_KEY above so the
# gateway can authenticate to this API server.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=
API_SERVER_CORS_ORIGINS=*

# ── Hermes default profile model ───────────────────────────────────────────
# provider/model are a pair. The provider selects which API_KEY is used.
HERMES_MODEL_PROVIDER=anthropic

# ── Hermes LLM provider keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# ── Hermes messaging gateway tokens (default profile only) ─────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# =============================================================================
# Option B — OpenClaw A2A Bridge
# =============================================================================
# Forwarded to a2a_daemon_engine.handlers.config:Config so the bridge can route
# A2A tasks to an OpenClaw Gateway instance via HTTP + SSE (OpenAI-compatible
# /v1/chat/completions) instead of in-process LLM calls.
#
# Prerequisites:
#   - OpenClaw Gateway running with chatCompletions API enabled
#   - a2a_daemon_engine installed (it is — baked into this image)
#
# When the `openclaw` compose profile is active, the bundled sibling OpenClaw
# service is reachable at http://openclaw:18789. When the profile is off,
# point OPENCLAW_API_URL at an external OpenClaw Gateway.
OPENCLAW_API_URL=http://openclaw:18789
# Bearer token for the OpenClaw Gateway — must match gateway.auth.token in
# openclaw.json. Read it with:
#   docker exec container-openclaw cat /root/.openclaw/openclaw.json | \
#     python -c "import sys,json;print(json.load(sys.stdin)['gateway']['auth']['token'])"
# See README "OpenClaw post-start setup" for details.
OPENCLAW_API_KEY=
# Default OpenClaw agent id (leave empty for the default agent):
OPENCLAW_AGENT_ID=
# Agent selection mode: "model" (model field) or "header" (x-openclaw-agent-id):
OPENCLAW_AGENT_SELECTOR=model
# SSE stream timeout in seconds:
OPENCLAW_STREAM_TIMEOUT=300

# ── Bundled OpenClaw Gateway (compose profile: openclaw) ────────────────────
# The OpenClaw Gateway runs as a sibling container ONLY when `openclaw` is in
# COMPOSE_PROFILES. Empty/omitted = external OpenClaw only (use
# OPENCLAW_API_URL above to point at it). When the profile is on, keep
# OPENCLAW_API_URL pointing at http://openclaw:18789 so the gateway reaches it.

# ── OpenClaw build args ──────────────────────────────────────────────────────
PIP_INDEX_URL=https://pypi.org/simple/
PYTHON=python3.12
NODE_VERSION=22

# ── OpenClaw ports ───────────────────────────────────────────────────────────
OPENCLAW_PORT=18789
OPENCLAW_CONTAINER_NAME=container-openclaw

# ── OpenClaw persistent data ─────────────────────────────────────────────────
# Host folder for OpenClaw configuration / agents / sessions:
OPENCLAW_FOLDER=./www/openclaw

# ── OpenClaw SSH access ──────────────────────────────────────────────────────
# The SAME deploy key used to build the main gateway image (see "Private
# repos over SSH" in README) is bind-mounted read-only into the openclaw
# container at runtime and copied into a proper ~/.ssh by its entrypoint —
# no separate key needed, and nothing SSH-related is baked into the openclaw
# image. Defaults to the repo-root ./.ssh; only change this if you want
# OpenClaw to use a DIFFERENT key than the main gateway build.
SSH_HOST_DIR=./.ssh

# =============================================================================
# Shared: persistent workspace folder (Hermes AND OpenClaw both mount this)
# =============================================================================
PROJECTS_FOLDER=./www/projects

# =============================================================================
# Ollama Cloud (used by the bundled Hermes and/or OpenClaw for LLM inference)
# =============================================================================
# Both values are passed through to whichever bundled agent container(s) are
# active. Hermes reads OLLAMA_BASE_URL; OpenClaw reads OLLAMA_HOST — same
# service, two var names, both point at the same Ollama Cloud endpoint.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_HOST=https://ollama.com

# =============================================================================
# Compose profiles — the single switch for ALL THREE optional bundled services
# =============================================================================
# Comma-separated. docker-compose reads this to start profile-gated services.
#   COMPOSE_PROFILES=                        gateway only (all externals)
#   COMPOSE_PROFILES=postgres                gateway + bundled Postgres
#   COMPOSE_PROFILES=hermes                  gateway + bundled Hermes
#   COMPOSE_PROFILES=openclaw                gateway + bundled OpenClaw
#   COMPOSE_PROFILES=hermes,openclaw         gateway + BOTH bundled bridges
#   COMPOSE_PROFILES=postgres,hermes,openclaw  gateway + Postgres + both bridges
#
# Bundled Postgres: keep PG_HOST=postgres. Bundled Hermes: keep
# HERMES_API_URL at http://hermes:<API_SERVER_PORT>. Bundled OpenClaw: keep
# OPENCLAW_API_URL at http://openclaw:18789. When a service is OFF, point its
# *_HOST / *_URL at your external instance instead.
COMPOSE_PROFILES=postgres,hermes
